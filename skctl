#!/usr/bin/env bash
#
# skctl — a tiny kubectl for Sheeternetes. Talks to the Apps Script apiserver.
# Requires: bash, curl, jq.
#
# Config via env (or a .skctl.env file next to this script):
#   WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec
#   TOKEN=CHANGE_ME_super_secret
#
# Usage:
#   skctl get pods|nodes|deployments|events
#   skctl apply lab/hello-web.json
#   skctl scale <deployment> <replicas>
#   skctl delete <deployment>
#   skctl tour                      # guided demo
#
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
[ -f "$here/.skctl.env" ] && . "$here/.skctl.env"
WEBAPP_URL="${WEBAPP_URL:?set WEBAPP_URL (Apps Script /exec URL)}"
TOKEN="${TOKEN:-CHANGE_ME_super_secret}"

api_get()  { curl -fsSL -m 30 "$WEBAPP_URL?token=$TOKEN&kind=$1"; }
api_post() { curl -fsSL -m 30 -X POST "$WEBAPP_URL" -H 'Content-Type: application/json' -d "$1"; }

cmd="${1:-help}"; shift || true

case "$cmd" in
  get)
    kind="${1:-pods}"
    case "$kind" in
      pods)        api_get pods | jq -r '["NAME","DEPLOYMENT","NODE","PHASE","CONTAINER"], (.items[]|[.name,.deployment,.node,.phase,(.container_id|tostring|.[0:12])]) | @tsv' | column -t -s $'\t' ;;
      nodes)       api_get nodes | jq -r '["NAME","IP","CPU","CPU_USED","MEM","STATUS","HEARTBEAT"], (.items[]|[.name,.ip,.cpu_total,.cpu_used,.mem_total,.status,.last_heartbeat]) | @tsv' | column -t -s $'\t' ;;
      deployments|deploy) api_get deployments | jq -r '["NAME","IMAGE","REPLICAS","CPU","MEM"], (.items[]|[.name,.image,.replicas,.cpu_req,.mem_req]) | @tsv' | column -t -s $'\t' ;;
      events)      api_get events | jq -r '.items[-25:][] | [.ts,.kind,.object,.message] | @tsv' | column -t -s $'\t' ;;
      *) echo "unknown kind: $kind" >&2; exit 1 ;;
    esac
    ;;
  apply)
    file="${1:?usage: skctl apply <file.json>}"
    spec="$(cat "$file")"
    api_post "$(jq -n --arg t "$TOKEN" --argjson d "$spec" '{token:$t, action:"apply", deployments:($d.deployments)}')" | jq .
    ;;
  scale)
    name="${1:?deployment}"; replicas="${2:?replicas}"
    api_post "$(jq -n --arg t "$TOKEN" --arg n "$name" --argjson r "$replicas" '{token:$t, action:"scale", name:$n, replicas:$r}')" | jq .
    ;;
  delete)
    name="${1:?deployment}"
    api_post "$(jq -n --arg t "$TOKEN" --arg n "$name" '{token:$t, action:"delete", name:$n}')" | jq .
    ;;
  tour)
    exec "$here/lab/tour.sh"
    ;;
  *)
    grep '^#' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac

#!/usr/bin/env bash
#
# skctl — a tiny kubectl for Sheeternetes. Talks to the Apps Script apiserver.
# Requires: bash, curl, jq.
#
# Config via env (or a .skctl.env file next to this script):
#   WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec
#   TOKEN=CHANGE_ME_super_secret
#
# Usage:
#   skctl get pods|nodes|deployments|events
#   skctl apply lab/hello-web.json
#   skctl scale <deployment> <replicas>
#   skctl delete <deployment>
#   skctl cordon|uncordon <node>
#   skctl autoscale <deployment> --cpu-percent <n> --min <n> --max <n>
#   skctl get hpa                   # the Autoscale tab
#   skctl revisions                 # the Sheet's version history
#   skctl restore --revision <id> | --at <time> [--tabs Deployments,...] [--dry-run]
#   skctl tour                      # guided demo
#
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
# environment variables win over .skctl.env
env_url="${WEBAPP_URL:-}"; env_token="${TOKEN:-}"
# shellcheck source=/dev/null
[ -f "$here/.skctl.env" ] && . "$here/.skctl.env"
WEBAPP_URL="${env_url:-${WEBAPP_URL:-}}"; TOKEN="${env_token:-${TOKEN:-}}"
WEBAPP_URL="${WEBAPP_URL:?set WEBAPP_URL (Apps Script /exec URL)}"
TOKEN="${TOKEN:-CHANGE_ME_super_secret}"

api_get()  { curl -fsSL -m 30 "$WEBAPP_URL?token=$TOKEN&kind=$1"; }
api_post() { curl -fsSL -m 30 -X POST "$WEBAPP_URL" -H 'Content-Type: application/json' -d "$1"; }

cmd="${1:-help}"; shift || true

case "$cmd" in
  get)
    kind="${1:-pods}"
    case "$kind" in
      pods)        api_get pods | jq -r '["NAME","DEPLOYMENT","NODE","PHASE","CONTAINER"], (.items[]|[.name,.deployment,.node,.phase,(.container_id|tostring|.[0:12])]) | @tsv' | column -t -s $'\t' ;;
      nodes)       api_get nodes | jq -r '["NAME","IP","CPU","CPU_USED","MEM","STATUS","LABELS","TAINTS","HEARTBEAT"], (.items[]|[.name,.ip,.cpu_total,.cpu_used,.mem_total,(.status + (if ((.schedulable|tostring|ascii_upcase) == "FALSE") then ",SchedulingDisabled" else "" end)),(.labels // "" | if . == "" then "<none>" else . end),(.taints // "" | if . == "" then "<none>" else . end),.last_heartbeat]) | @tsv' | column -t -s $'\t' ;;
      deployments|deploy) api_get deployments | jq -r '["NAME","IMAGE","REPLICAS","CPU","MEM"], (.items[]|[.name,.image,.replicas,.cpu_req,.mem_req]) | @tsv' | column -t -s $'\t' ;;
      hpa|autoscale) api_get autoscale | jq -r '["DEPLOYMENT","TARGET","CPU","MIN","MAX","REPLICAS","DESIRED","STATUS"], (.items[]|[.deployment,((.target_cpu|tostring)+"%"),((.cpu_percent|tostring)+(if .cpu_percent == "" then "<unknown>" else "%" end)),.min_replicas,.max_replicas,.current_replicas,.desired_replicas,.status]) | @tsv' | column -t -s $'\t' ;;
      events)      api_get events | jq -r '.items[-25:][] | [.ts,.kind,.object,.message] | @tsv' | column -t -s $'\t' ;;
      *) echo "unknown kind: $kind" >&2; exit 1 ;;
    esac
    ;;
  apply)
    file="${1:?usage: skctl apply <file.json>}"
    spec="$(cat "$file")"
    api_post "$(jq -n --arg t "$TOKEN" --argjson d "$spec" '{token:$t, action:"apply", deployments:($d.deployments)}')" | jq .
    ;;
  scale)
    name="${1:?deployment}"; replicas="${2:?replicas}"
    api_post "$(jq -n --arg t "$TOKEN" --arg n "$name" --argjson r "$replicas" '{token:$t, action:"scale", name:$n, replicas:$r}')" | jq .
    ;;
  delete)
    name="${1:?deployment}"
    api_post "$(jq -n --arg t "$TOKEN" --arg n "$name" '{token:$t, action:"delete", name:$n}')" | jq .
    ;;
  cordon|uncordon)
    name="${1:?node}"
    api_post "$(jq -n --arg t "$TOKEN" --arg a "$cmd" --arg n "$name" '{token:$t, action:$a, name:$n}')" | jq .
    ;;
  autoscale)
    name="${1:?usage: skctl autoscale <deployment> --cpu-percent <n> [--min <n>] [--max <n>]}"; shift
    cpu=""; min=1; max=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --cpu-percent) cpu="${2:?}"; shift 2 ;;
        --min) min="${2:?}"; shift 2 ;;
        --max) max="${2:?}"; shift 2 ;;
        *) echo "unknown flag $1" >&2; exit 1 ;;
      esac
    done
    [ -n "$cpu" ] || { echo "--cpu-percent is required" >&2; exit 1; }
    api_post "$(jq -n --arg t "$TOKEN" --arg n "$name" --argjson c "$cpu" --argjson lo "$min" --argjson hi "${max:-$min}" \
      '{token:$t, action:"autoscale", deployment:$n, target_cpu:$c, min_replicas:$lo, max_replicas:$hi}')" | jq .
    ;;
  revisions)
    api_get revisions | jq -r 'if .error then error(.error) else . end | ["REVISION","MODIFIED"], (.items[] | [.id, .modifiedTime]) | @tsv' | column -t -s $'\t'
    ;;
  restore)
    rev=""; at=""; tabs=""; dry=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --revision) rev="${2:?}"; shift 2 ;;
        --at) at="${2:?}"; shift 2 ;;
        --tabs) tabs="${2:?}"; shift 2 ;;
        --dry-run) dry=true; shift ;;
        *) echo "usage: skctl restore --revision <id> | --at <time> [--tabs Deployments,...] [--dry-run]" >&2; exit 1 ;;
      esac
    done
    [ -n "$rev$at" ] || { echo "restore needs --revision or --at" >&2; exit 1; }
    api_post "$(jq -n --arg t "$TOKEN" --arg r "$rev" --arg a "$at" --arg tabs "$tabs" --argjson d "$dry" \
      '{token:$t, action:"restore", dryRun:$d}
       + (if $r != "" then {revision:$r} else {at:$a} end)
       + (if $tabs != "" then {tabs:($tabs | split(","))} else {} end)')" \
      | jq 'if .error then error(.error) else del(.state) end'
    ;;
  tour)
    exec "$here/lab/tour.sh"
    ;;
  *)
    grep '^#' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac

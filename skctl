#!/usr/bin/env bash
#
# skctl — a tiny kubectl for Sheeternetes. Talks to the Apps Script apiserver.
# Requires: bash, curl, jq.
#
# Config via env (or a .skctl.env file next to this script):
#   WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec
#   TOKEN=CHANGE_ME_super_secret
#
# Usage:
#   skctl get pods|nodes|deployments|events
#   skctl apply lab/hello-web.json
#   skctl scale <deployment> <replicas>
#   skctl delete <deployment>
#   skctl cordon|uncordon <node>
#   skctl autoscale <deployment> --cpu-percent <n> --min <n> --max <n>
#   skctl get hpa                   # the Autoscale tab
#   skctl revisions                 # the Sheet's version history
#   skctl restore --revision <id> | --at <time> [--tabs Deployments,...] [--dry-run]
#   skctl tour                      # guided demo
#
# Script pods and Sheetstor volumes (docs/script-runtime.md):
#   skctl get scripts|volumes|secrets|budget   # budget: trigger time per day vs the 90 min quota
#   skctl volume create <name> [--ro] | ls [<name>] | put <name> <path> <file> | get <name> <path> [<file>]
#   skctl volume rm <name> <path> | delete <name>
#   skctl secret set <name> KEY=VALUE... (KEY=- reads the value from stdin) | ls | rm <name>
#   skctl run <deployment> [-- <fn> <args...>]
#   skctl logs <pod|deployment> [--previous]
#   skctl webhook <deployment> [--rotate]   # prints the webhook URL (it carries a key: keep it private)
#
# A smoke check against real Google Sheets (scratch spreadsheets in the owner's Drive, trashed afterwards):
#   skctl selftest [--locale en_US,ru_RU] [--keep]
#
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
# environment variables win over .skctl.env
env_url="${WEBAPP_URL:-}"; env_token="${TOKEN:-}"
# shellcheck source=/dev/null
[ -f "$here/.skctl.env" ] && . "$here/.skctl.env"
WEBAPP_URL="${env_url:-${WEBAPP_URL:-}}"; TOKEN="${env_token:-${TOKEN:-}}"
WEBAPP_URL="${WEBAPP_URL:?set WEBAPP_URL (Apps Script /exec URL)}"
TOKEN="${TOKEN:-CHANGE_ME_super_secret}"

api_get()  { curl -fsSL -m 30 "$WEBAPP_URL?token=$TOKEN&kind=$1"; }
api_post() { curl -fsSL -m 30 "$WEBAPP_URL" -H 'Content-Type: application/json' -d "$1"; }
# long-running calls; the JSON body comes on stdin (large files, secrets stay out of argv)
api_post_stdin() { curl -fsSL -m 360 "$WEBAPP_URL" -H 'Content-Type: application/json' --data-binary @-; }
or_fail() { jq 'if .error then error(.error) else . end'; }

cmd="${1:-help}"; shift || true

case "$cmd" in
  get)
    kind="${1:-pods}"
    case "$kind" in
      scripts) api_get scripts | jq -r '["NAME","POD","REPLICAS","SCHEDULE","WEBHOOK","RESTARTS","LAST_RUN","LAST_ERROR"], (.items[]|[.name,(.pod|if . == "" then "<none>" else . end),.replicas,(.schedule|tostring|if . == "" then "<none>" else .[0:40] end),.webhook,.restarts,(.last_run|if . == "" then "<never>" else . end),(.last_error|if . == "" then "<none>" else .[0:60] end)]) | @tsv' | column -t -s $'\t'; exit ;;
      volumes) api_get volumes | jq -r '["NAME","MODE","GENERATION","FILES","SIZE","SHA256"], (.items[]|[.name,.mode,.generation,.files,.size,(.sha256|.[0:19])]) | @tsv' | column -t -s $'\t'; exit ;;
      budget) api_get budget | jq -r '["DATE","TICKS","TRIGGER_MS","MAX_TICK_MS","USED_%","IDLE","PASSES","RECONCILES"], (.items[]|[.date,.ticks,.trigger_ms,.max_tick_ms,.used_percent,(.idle // ""),(.passes // ""),(.reconciles // "")]), (.today|select(.)|["today (live)",.ticks,.ms,.max,((.ms/5400000*1000|round)/10),(.idle // 0),(.passes // 0),(.reconciles // 0)]) | @tsv' | column -t -s $'\t'; exit ;;
      secrets) api_get secrets | jq -r '["NAME","KEYS"], (.items[]|[.name,(.keys|join(","))]) | @tsv' | column -t -s $'\t'; exit ;;
    esac
    case "$kind" in
      pods)        api_get pods | jq -r '["NAME","DEPLOYMENT","NODE","PHASE","CONTAINER"], (.items[]|[.name,.deployment,.node,.phase,(.container_id|tostring|.[0:12])]) | @tsv' | column -t -s $'\t' ;;
      nodes)       api_get nodes | jq -r '["NAME","IP","CPU","CPU_USED","MEM","STATUS","LABELS","TAINTS","HEARTBEAT"], (.items[]|[.name,.ip,.cpu_total,.cpu_used,.mem_total,(.status + (if ((.schedulable|tostring|ascii_upcase) == "FALSE") then ",SchedulingDisabled" else "" end)),(.labels // "" | if . == "" then "<none>" else . end),(.taints // "" | if . == "" then "<none>" else . end),.last_heartbeat]) | @tsv' | column -t -s $'\t' ;;
      deployments|deploy) api_get deployments | jq -r '["NAME","IMAGE","REPLICAS","CPU","MEM"], (.items[]|[.name,.image,.replicas,.cpu_req,.mem_req]) | @tsv' | column -t -s $'\t' ;;
      hpa|autoscale) api_get autoscale | jq -r '["DEPLOYMENT","TARGET","CPU","MIN","MAX","REPLICAS","DESIRED","STATUS"], (.items[]|[.deployment,((.target_cpu|tostring)+"%"),((.cpu_percent|tostring)+(if .cpu_percent == "" then "<unknown>" else "%" end)),.min_replicas,.max_replicas,.current_replicas,.desired_replicas,.status]) | @tsv' | column -t -s $'\t' ;;
      events)      api_get events | jq -r '.items[-25:][] | [.ts,.kind,.object,.message] | @tsv' | column -t -s $'\t' ;;
      *) echo "unknown kind: $kind" >&2; exit 1 ;;
    esac
    ;;
  apply)
    file="${1:?usage: skctl apply <file.json>}"
    spec="$(cat "$file")"
    api_post "$(jq -n --arg t "$TOKEN" --argjson d "$spec" '{token:$t, action:"apply", deployments:($d.deployments)}')" | jq .
    ;;
  scale)
    name="${1:?deployment}"; replicas="${2:?replicas}"
    api_post "$(jq -n --arg t "$TOKEN" --arg n "$name" --argjson r "$replicas" '{token:$t, action:"scale", name:$n, replicas:$r}')" | jq .
    ;;
  delete)
    name="${1:?deployment}"
    api_post "$(jq -n --arg t "$TOKEN" --arg n "$name" '{token:$t, action:"delete", name:$n}')" | jq .
    ;;
  cordon|uncordon)
    name="${1:?node}"
    api_post "$(jq -n --arg t "$TOKEN" --arg a "$cmd" --arg n "$name" '{token:$t, action:$a, name:$n}')" | jq .
    ;;
  autoscale)
    name="${1:?usage: skctl autoscale <deployment> --cpu-percent <n> [--min <n>] [--max <n>]}"; shift
    cpu=""; min=1; max=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --cpu-percent) cpu="${2:?}"; shift 2 ;;
        --min) min="${2:?}"; shift 2 ;;
        --max) max="${2:?}"; shift 2 ;;
        *) echo "unknown flag $1" >&2; exit 1 ;;
      esac
    done
    [ -n "$cpu" ] || { echo "--cpu-percent is required" >&2; exit 1; }
    api_post "$(jq -n --arg t "$TOKEN" --arg n "$name" --argjson c "$cpu" --argjson lo "$min" --argjson hi "${max:-$min}" \
      '{token:$t, action:"autoscale", deployment:$n, target_cpu:$c, min_replicas:$lo, max_replicas:$hi}')" | jq .
    ;;
  revisions)
    api_get revisions | jq -r 'if .error then error(.error) else . end | ["REVISION","MODIFIED"], (.items[] | [.id, .modifiedTime]) | @tsv' | column -t -s $'\t'
    ;;
  restore)
    rev=""; at=""; tabs=""; dry=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --revision) rev="${2:?}"; shift 2 ;;
        --at) at="${2:?}"; shift 2 ;;
        --tabs) tabs="${2:?}"; shift 2 ;;
        --dry-run) dry=true; shift ;;
        *) echo "usage: skctl restore --revision <id> | --at <time> [--tabs Deployments,...] [--dry-run]" >&2; exit 1 ;;
      esac
    done
    [ -n "$rev$at" ] || { echo "restore needs --revision or --at" >&2; exit 1; }
    api_post "$(jq -n --arg t "$TOKEN" --arg r "$rev" --arg a "$at" --arg tabs "$tabs" --argjson d "$dry" \
      '{token:$t, action:"restore", dryRun:$d}
       + (if $r != "" then {revision:$r} else {at:$a} end)
       + (if $tabs != "" then {tabs:($tabs | split(","))} else {} end)')" \
      | jq 'if .error then error(.error) else del(.state) end'
    ;;
  tour)
    exec "$here/lab/tour.sh"
    ;;
  volume)
    sub="${1:-ls}"; shift || true
    case "$sub" in
      create)
        mode=rw; [ "${2:-}" = "--ro" ] && mode=ro
        api_post "$(jq -n --arg t "$TOKEN" --arg n "${1:?volume}" --arg m "$mode" '{token:$t, action:"volumeCreate", name:$n, mode:$m}')" | or_fail ;;
      ls)
        if [ -n "${1:-}" ]; then
          curl -fsSL -m 30 "$WEBAPP_URL?token=$TOKEN&kind=files&name=$1" | or_fail | jq -r '["PATH","SIZE","GENERATION","SHA256"], (.items[]|[.path,.size,.generation,.sha256]) | @tsv' | column -t -s $'\t'
        else exec "$0" get volumes; fi ;;
      put)
        name="${1:?volume}"; path="${2:?path}"; file="${3:?local file}"
        sum="sha256:$(shasum -a 256 "$file" | cut -d' ' -f1)"
        base64 < "$file" | tr -d '\n' | jq -Rs --arg t "$TOKEN" --arg n "$name" --arg p "$path" --arg s "$sum" \
          '{token:$t, action:"volumePut", name:$n, path:$p, sha256:$s, data:.}' | api_post_stdin | or_fail ;;
      get)
        name="${1:?volume}"; path="${2:?path}"; out="${3:-/dev/stdout}"
        jq -n --arg t "$TOKEN" --arg n "$name" --arg p "$path" '{token:$t, action:"volumeGet", name:$n, path:$p}' \
          | api_post_stdin | or_fail | jq -r .data | base64 -d > "$out" ;;
      rm)
        api_post "$(jq -n --arg t "$TOKEN" --arg n "${1:?volume}" --arg p "${2:?path}" '{token:$t, action:"volumeRm", name:$n, path:$p}')" | or_fail ;;
      delete)
        api_post "$(jq -n --arg t "$TOKEN" --arg n "${1:?volume}" '{token:$t, action:"volumeDelete", name:$n}')" | or_fail ;;
      *) echo "usage: skctl volume create|ls|put|get|rm|delete ..." >&2; exit 1 ;;
    esac
    ;;
  secret)
    sub="${1:-ls}"; shift || true
    case "$sub" in
      set)
        name="${1:?secret name}"; shift
        data='{}'
        for kv in "$@"; do
          k="${kv%%=*}"; v="${kv#*=}"
          if [ "$v" = "-" ]; then v="$(cat)"; fi
          data="$(jq -c --arg k "$k" --arg v "$v" '. + {($k): $v}' <<<"$data")"
        done
        jq -n --arg t "$TOKEN" --arg n "$name" --argjson d "$data" '{token:$t, action:"secretSet", name:$n, data:$d}' | api_post_stdin | or_fail ;;
      ls) exec "$0" get secrets ;;
      rm) api_post "$(jq -n --arg t "$TOKEN" --arg n "${1:?secret}" '{token:$t, action:"secretDelete", name:$n}')" | or_fail ;;
      *) echo "usage: skctl secret set|ls|rm ..." >&2; exit 1 ;;
    esac
    ;;
  selftest)
    locales=""; keep=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --locale) locales="${2:?--locale en_US,ru_RU}"; shift 2 ;;
        --keep) keep=true; shift ;;
        *) echo "usage: skctl selftest [--locale en_US,ru_RU] [--keep]" >&2; exit 1 ;;
      esac
    done
    jq -n --arg t "$TOKEN" --arg l "$locales" --argjson k "$keep" '{token:$t, action:"selftest", locales:($l | split(",") | map(select(. != ""))), keep:$k}' \
      | api_post_stdin | jq -r 'if .error then error(.error) else . end
          | (.results[] | "\(.locale): \(if .ok then "PASS" else "FAIL" end) in \(.ms / 1000 | floor) s (\(.spreadsheet))",
             (.checks[] | "  \(if .ok then "ok  " else "FAIL" end) \(.name)\(if .detail != "" then " -> " + .detail else "" end)")),
            (if .ok then "selftest passed" else ("selftest FAILED\n" | halt_error(1)) end)'
    ;;
  run)
    name="${1:?deployment}"; shift
    [ "${1:-}" = "--" ] && shift
    jq -n --arg t "$TOKEN" --arg n "$name" '{token:$t, action:"run", name:$n, args:$ARGS.positional}' --args "$@" \
      | api_post_stdin | jq 'if .error then (.logs // [] | .[] | "log: " + . | stderr) | error(.error) else . end'
    ;;
  logs)
    target="${1:?pod or deployment}"; field="tail"
    [ "${2:-}" = "--previous" ] && field=previous
    pod="$(api_get pods | jq -r --arg t "$target" '[.items[] | select(.name == $t or (.deployment == $t and .phase == "Running"))][0].name // $t')"
    curl -fsSL -m 30 "$WEBAPP_URL?token=$TOKEN&kind=logs&name=$pod" | jq -r --arg f "$field" '.items[0][$f] // ""'
    ;;
  webhook)
    name="${1:?deployment}"; rot=false; [ "${2:-}" = "--rotate" ] && rot=true
    q="$(api_post "$(jq -n --arg t "$TOKEN" --arg n "$name" --argjson r "$rot" '{token:$t, action:"webhook", name:$n, rotate:$r}')" | or_fail | jq -r .query)"
    echo "$WEBAPP_URL$q"
    ;;
  *)
    grep '^#' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
